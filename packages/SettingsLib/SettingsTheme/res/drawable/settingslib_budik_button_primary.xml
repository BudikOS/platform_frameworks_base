<?xml version="1.0" encoding="utf-8"?>
<!-- Budík OS primary button: navy keycap, radius 12, hard 3dp shadow; pressed = key sinks in. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <layer-list>
                    <item android:top="3dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/settingslib_budik_line" />
                            <corners android:radius="@dimen/settingslib_budik_radius_m" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:state_pressed="true">
                <layer-list>
                    <item android:top="3dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/settingslib_budik_primary" />
                            <corners android:radius="@dimen/settingslib_budik_radius_m" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item android:top="3dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/settingslib_budik_primary_ink" />
                            <corners android:radius="@dimen/settingslib_budik_radius_m" />
                        </shape>
                    </item>
                    <item android:bottom="3dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/settingslib_budik_primary" />
                            <corners android:radius="@dimen/settingslib_budik_radius_m" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
