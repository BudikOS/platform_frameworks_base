<?xml version="1.0" encoding="utf-8"?>
<!-- Budík OS dialog card: surface, radius 20, 1dp line, hard 4dp shadow (no blur, no elevation). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="24dp"
    android:insetRight="24dp"
    android:insetTop="16dp"
    android:insetBottom="16dp">
    <layer-list>
        <item android:top="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/settingslib_budik_dialog_shadow" />
                <corners android:radius="@dimen/settingslib_budik_radius_l" />
            </shape>
        </item>
        <item android:bottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/settingslib_budik_surface" />
                <stroke android:width="1dp" android:color="@color/settingslib_budik_line" />
                <corners android:radius="@dimen/settingslib_budik_radius_l" />
            </shape>
        </item>
    </layer-list>
</inset>
